# Copy to .env.local and fill in. .env.local is gitignored.

# REQUIRED — Claude (Anthropic) powers the style suggestions and the match verdict.
ANTHROPIC_API_KEY=sk-ant-...

# REQUIRED for the /match composite preview — gpt-image-1 places the item onto the bed.
# NOTE: the OpenAI organisation must be verified for gpt-image-1, or this returns 403.
OPENAI_API_KEY=sk-...

# OPTIONAL — real product/style thumbnails. Falls back to picsum.photos if unset.
UNSPLASH_ACCESS_KEY=
